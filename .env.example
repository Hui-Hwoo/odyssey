# Environment variables template.
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
#
# NOTE: These are only needed by the offline data-generation script (src/utils/parse-data.js)
# if you wire it up to Notion. The deployed site does not read any of these at runtime.

# Notion integration token (prefix VITE_ to expose to client code under Vite)
VITE_NOTION_TOKEN=
# Notion database id to pull project data from
DATABASE_ID=
